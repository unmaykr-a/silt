# Silt configuration. Copy to .env and uncomment what you need.
#
#   cp .env.example .env
#
# Every one of these has a working default, so an empty .env is a valid .env.
# The compose file only sets SILT_DOCKER_HOST, because that one depends on how
# the stack is wired rather than on what you want.
#
# Most of these can also be changed on the Settings screen without recreating
# the container. The ones that cannot are marked "restart required" — either
# because the process reads them once, or because they are the boundary
# protecting that screen and a UI able to widen them would be a way in.

# ─── Where Silt listens ───────────────────────────────────────────────────────

# Host port to publish. Change this rather than SILT_LISTEN_ADDR.
#SILT_PORT=8375

# The address inside the container. Restart required.
#SILT_LISTEN_ADDR=:8375

# Where Silt is reachable from a browser. Used for links in notifications and
# to derive the OpenID Connect callback URL.
#SILT_BASE_URL=https://silt.example.lan

# ─── Signing in ───────────────────────────────────────────────────────────────
#
# Out of the box Silt asks you to choose a password the first time you open it.
# Until you do, every request is refused. You can change it, link it to an
# identity provider, or turn it off later under Settings → Security.

# Set this to claim the account before Silt ever starts, instead of choosing a
# password in the UI. Note the doubled $ — compose eats single ones.
# Generate with: htpasswd -bnBC 12 "" 'your password' | tr -d ':\n'
#SILT_PASSWORD_HASH=$$2a$$12$$...

# Turn the built-in account off entirely, for an install that authenticates
# only through a provider or a proxy. Restart required.
#SILT_LOCAL_ACCOUNT=true

# OpenID Connect — authentik, Authelia, Keycloak, Pocket ID, anything standard.
# Register the callback as $SILT_BASE_URL/api/auth/callback. Restart required.
#SILT_OIDC_ISSUER=https://auth.example.lan/application/o/silt/
#SILT_OIDC_CLIENT_ID=
#SILT_OIDC_CLIENT_SECRET=
#SILT_OIDC_REDIRECT_URL=          # only if it is not $SILT_BASE_URL/api/auth/callback
#SILT_OIDC_SCOPES=openid,profile,email
#SILT_OIDC_ALLOWED_GROUPS=        # empty admits anyone the provider authenticates
#SILT_OIDC_ALLOWED_USERS=
#SILT_OIDC_USERNAME_CLAIM=preferred_username
#SILT_OIDC_GROUPS_CLAIM=groups    # some providers use `roles`

# Forward auth: believe an identity your reverse proxy asserts in a header.
# Restart required.
#SILT_TRUST_PROXY_AUTH=true
#SILT_AUTH_HEADER=X-Remote-User
# SET THIS if you use forward auth. The header is settable by anything that can
# open a socket, so without a trust list "authenticated" means "reached the
# port" — which on a shared Docker network is every other container on it.
#SILT_TRUSTED_PROXIES=172.18.0.0/16

# How long a session lasts, and how long an unused one survives.
#SILT_SESSION_TTL=720h
#SILT_SESSION_IDLE_TTL=168h

# ─── What Silt reads ──────────────────────────────────────────────────────────

# Capture the compose and .env files themselves, so you can diff them line by
# line. This is an allowlist: Silt reads nothing outside it, and the paths must
# also be mounted read-only in docker-compose.yml. Restart required.
#SILT_COMPOSE_ROOTS=/srv,/opt

# Largest single file to capture.
#SILT_MAX_COMPOSE_FILE_BYTES=1048576

# How often to sweep for anything the event stream missed.
#SILT_SNAPSHOT_INTERVAL=5m

# Extra environment keys kept readable instead of redacted. Everything not on
# the built-in safe list becomes a keyed digest. One leading or trailing * is
# allowed.
#SILT_KEEP_KEYS=MY_APP_REGION,APP_*

# What to call this Docker host in the database. Restart required.
#SILT_HOST_NAME=local

# ─── How long Silt keeps it ───────────────────────────────────────────────────
#
# Zero means keep forever. Runtime-only snapshots are the proof-of-liveness
# rows between changes, and cannot outlive the changes they sit between.

#SILT_RETENTION_DAYS=365
#SILT_UNCHANGED_RETENTION_DAYS=7
#SILT_EVENT_RETENTION_DAYS=90
#SILT_RETENTION_INTERVAL=1h
#SILT_VACUUM_INTERVAL=0

# ─── Notifications ────────────────────────────────────────────────────────────
#
# Any shoutrrr target: ntfy, Gotify, Discord, email. Kinds and severity are
# ANDed, so you get changes that are both interesting and important.

#SILT_NOTIFY_URLS=ntfy://ntfy.sh/my-silt-topic
#SILT_NOTIFY_ON=image_id,image_digest,volumes,service_removed
#SILT_NOTIFY_MIN_SEVERITY=medium

# ─── Everything else ──────────────────────────────────────────────────────────

# External events from Uptime Kuma, cron, Home Assistant. Unset, the endpoint
# refuses every request rather than accepting anything.
#SILT_INGEST_TOKEN=

# /metrics needs authentication by default: it names every project on this host
# and counts their changes. Set this if a scrape cannot present a session.
#SILT_METRICS_PUBLIC=false

# Where the database lives inside the container. Restart required.
#SILT_DB_PATH=/data/silt.db

#SILT_LOG_LEVEL=info
