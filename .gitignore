# Build output
/silt
/dist/

# Frontend build output. The directory itself is tracked via
# internal/web/dist/.gitkeep so that //go:embed compiles on a clean checkout;
# only the generated files are ignored. See PROJECT.md Section 12.
/internal/web/dist/*
!/internal/web/dist/.gitkeep
/web/node_modules/
/web/dist/
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/

# Scratch directories for `make demo` and `make e2e`.
/.demo/
/.e2e/

# Local data
*.db
*.db-shm
*.db-wal
/data/

# Editors
.DS_Store
*.swp
/web/src/lib/api/schema.d.ts

# Local configuration, copied from .env.example.
.env
.demo-site/
.shots/
